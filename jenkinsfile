pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Show Files') {
            steps {
                sh 'ls -la'
            }
        }

        stage('Read Files') {
            steps {
                sh 'cat first-file.txt'
                sh 'cat mpr-chethan.txt'
            }
        }
    }
}
